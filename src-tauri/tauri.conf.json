{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WKeePass",
  "version": "1.2.1",
  "identifier": "de.wuefl.wkeepass",
  "build": {
    "frontendDist": "../src-ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "python3 tools/devserver.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WKeePass",
        "width": 1100,
        "height": 780,
        "minWidth": 300,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../appdata/icons/32x32.png",
      "../appdata/icons/64x64.png",
      "../appdata/icons/128x128.png",
      "../appdata/icons/128x128@2x.png",
      "../appdata/icons/icon.icns",
      "../appdata/icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "recommends": ["libayatana-appindicator3-1"],
        "files": {
          "/usr/share/metainfo/de.wuefl.wkeepass.metainfo.xml": "../appdata/linux/de.wuefl.wkeepass.metainfo.xml"
        }
      },
      "rpm": {
        "recommends": ["libayatana-appindicator-gtk3"],
        "files": {
          "/usr/share/metainfo/de.wuefl.wkeepass.metainfo.xml": "../appdata/linux/de.wuefl.wkeepass.metainfo.xml"
        }
      }
    },
    "category": "Utility",
    "homepage": "https://wuefl.de/wkeepass/",
    "shortDescription": "Passwortverwaltung für KeePass-Datenbanken",
    "longDescription": "WKeePass ist ein Passwortmanager auf Basis des KeePass-Formats: Passwörter, 2FA-Codes, Passkeys und Dateien verschlüsselt in einer Datei, die Ihnen gehört. Ausfüllen im Browser über KeePassXC-Browser, Abgleich über jeden Cloud-Ordner, kompatibel mit KeePassXC, KeePassDX und Strongbox. Kein Konto, kein Abo, keine Werbung.",
    "fileAssociations": [
      {
        "ext": [
          "kdbx"
        ],
        "name": "KeePass-Datenbank",
        "description": "KeePass-Datenbank",
        "mimeType": "application/x-keepass2",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "otpauth",
            "otpauth-migration"
          ],
          "appLink": false
        }
      ]
    }
  }
}
