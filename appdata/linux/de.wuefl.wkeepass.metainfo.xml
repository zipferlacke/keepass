<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>de.wuefl.wkeepass</id>
  <name>WKeePass</name>
  <summary>Passwortverwaltung für KeePass-Datenbanken</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="de.wuefl">
    <name>wuefl</name>
  </developer>
  <description>
    <p>
      WKeePass ist ein Passwortmanager auf Basis des KeePass-Formats. Die Zugangsdaten liegen
      verschlüsselt in einer Datei, die Ihnen gehört – kein Konto, kein Abo, keine Werbung.
    </p>
    <ul>
      <li>Passwörter in Ordnern, mit Suche, Generator und Stärke-Anzeige</li>
      <li>2FA-Codes (TOTP) und Passkeys direkt beim Eintrag</li>
      <li>Ausfüllen im Browser über die Erweiterung KeePassXC-Browser</li>
      <li>Verschlüsselte Dateiablage mit Vorschau</li>
      <li>Abgleich über Nextcloud, Dropbox oder jeden anderen Cloud-Ordner – gleichzeitige Änderungen werden zusammengeführt</li>
      <li>Liest und schreibt KDBX 4.1 – dieselbe Datei öffnen KeePassXC, KeePassDX und Strongbox</li>
    </ul>
    <p>
      Die Passwörter verarbeitet der Kern der App; die Oberfläche sieht nie den Klartext.
    </p>
  </description>
  <launchable type="desktop-id">WKeePass.desktop</launchable>
  <icon type="stock">wkeepass</icon>
  <pkgname>w-kee-pass</pkgname>
  <url type="homepage">https://wuefl.de/wkeepass/</url>
