<?xml version="1.0" encoding="utf-8"?>

<!--
  Womit sich der Passkey-Anbieter bei Android meldet: Wir können Passkeys.
  Passwörter laufen über Autofill, nicht über den Credential Manager.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
