<?xml version="1.0" encoding="utf-8"?>
<!-- Entsperren oder Nachweis: Kopf, Biometrie-Knopf, Umschalter, Feld.
     Was davon zu sehen ist, entscheidet Nachweisblatt.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wkeepass_blatt"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:alpha="0.4"
        android:background="@color/wkeepass_leise" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wkeepass_nachweis_titel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/wkeepass_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wkeepass_nachweis_unten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/wkeepass_leise"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/wkeepass_nachweis_biometrie"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/wkeepass_knopf"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/wkeepass_text"
        android:textSize="15sp" />

    <!-- PIN oder Master-Passwort — nur da, wenn es beides gibt. -->
    <LinearLayout
        android:id="@+id/wkeepass_nachweis_wege"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/wkeepass_nachweis_pin"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/wkeepass_knopf_leise"
            android:stateListAnimator="@null"
            android:text="PIN"
            android:textAllCaps="false"
            android:textColor="@color/wkeepass_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/wkeepass_nachweis_master"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/wkeepass_knopf_leise"
            android:stateListAnimator="@null"
            android:text="Master-Passwort"
            android:textAllCaps="false"
            android:textColor="@color/wkeepass_text"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/wkeepass_nachweis_feld"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/wkeepass_suchfeld"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/wkeepass_text"
        android:textColorHint="@color/wkeepass_leise"
        android:textSize="15sp" />

    <Button
        android:id="@+id/wkeepass_nachweis_weiter"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/wkeepass_knopf"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/wkeepass_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/wkeepass_nachweis_meldung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/wkeepass_leise"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
