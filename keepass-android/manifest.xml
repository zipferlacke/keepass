<!--
  Der Block, der in AndroidManifest.xml gehört.

  Keine eigenständige Datei — Android liest nur das Manifest des Projekts
  unter `gen/android/app/src/main/`. Hier steht er, damit er versioniert ist
  und nicht bei jedem `cargo tauri android init` neu erfunden werden muss.

  Einzusetzen innerhalb von <application>.
-->

<service
    android:name="de.wuefl.wkeepass.autofill.WKeePassAutofillService"
    android:label="WKeePass"
    android:permission="android.permission.BIND_AUTOFILL_SERVICE"
    android:exported="true">

    <!--
      `permission` und `exported` gehören zusammen: Der Dienst muss von außen
      erreichbar sein, sonst findet ihn das System nicht — aber nur für das
      System. Die Berechtigung hält jeden anderen Aufrufer fern.
    -->

    <intent-filter>
        <action android:name="android.service.autofill.AutofillService" />
    </intent-filter>

    <meta-data
        android:name="android.autofill"
        android:resource="@xml/autofill_service" />
</service>

<!--
  Die Activity, die beim Antippen eines Vorschlags aufgeht.

  `exported="false"`: Gestartet wird sie ausschließlich über den
  PendingIntent, den der Dienst dem System übergibt. Von außen aufrufbar
  wäre sie ein Weg, an der Legitimation vorbeizukommen.

  `excludeFromRecents` und der durchsichtige Stil, weil sie kein Fenster
  ist, das man später wiederfinden will — sie erscheint über der fremden
  App und verschwindet wieder.
-->
<activity
    android:name="de.wuefl.wkeepass.autofill.AusfuellActivity"
    android:exported="false"
    android:excludeFromRecents="true"
    android:theme="@android:style/Theme.Translucent.NoTitleBar" />
